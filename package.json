{
  "name": "multi-agent-orchestrator-node",
  "version": "1.0.0",
  "description": "Enterprise-grade Distributed Multi-Agent AI Orchestrator built with Fastify, LangGraph, Redis BullMQ and PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "worker": "tsx watch src/queues/worker.ts"
  },
  "keywords": [
    "multi-agent",
    "langgraph",
    "langchain",
    "redis",
    "bullmq",
    "fastify",
    "typescript",
    "ai-agents",
    "supervisor-agent",
    "sse-streaming"
  ],
  "author": "Dev Rodrigues",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@langchain/community": "^0.2.0",
    "@langchain/core": "^0.2.0",
    "@langchain/langgraph": "^0.0.23",
    "@langchain/openai": "^0.1.0",
    "bullmq": "^5.7.8",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "ioredis": "^5.4.1",
    "pg": "^8.11.5",
    "pino": "^9.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "@vitest/coverage-v8": "^1.6.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
